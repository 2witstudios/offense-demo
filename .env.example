NODE_ENV=development
# One shared local stack (infra/compose.yaml): Postgres on host port 15432,
# Redis on 6379 (override with OFFENSE_DEMO_POSTGRES_PORT / OFFENSE_DEMO_REDIS_PORT when
# another project's stack already holds them, and change the URLs to match). `bun slot:up` owns the slot values below: in the main
# checkout they are these defaults; in a git worktree it rewrites the
# database names, Redis namespaces and ports to that worktree's own slot
# (ADR 0034). Keep host, port and credentials; never hand-edit slot names.
# To run beside another project's stack, publish this one on other host
# ports (infra/compose.yaml reads the same variables) and `bun slot:up`
# moves the URLs below to them:
# OFFENSE_DEMO_POSTGRES_PORT=25432
# OFFENSE_DEMO_REDIS_PORT=16379
# Likewise, move the main checkout's app off 3000 (realtime follows at +11,
# the browser suite at +100..+103); `bun slot:up` rewrites PORT from it:
# OFFENSE_DEMO_APP_PORT=3020
DATABASE_URL=postgres://offense_demo:local-development-only@localhost:15432/offense_demo
REDIS_URL=redis://localhost:6379
REDIS_NAMESPACE=offense-demo
PORT=3000
# apps/realtime (ADR 0031); distinct from PORT so both run at once. Also a
# slot value: `bun slot:up` derives a worktree's own REALTIME_PORT.
REALTIME_PORT=3011
PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
APP_VERSION=development
GIT_COMMIT=unknown
TEST_DATABASE_URL=postgres://offense_demo:local-development-only@localhost:15432/offense_demo_test
TEST_REDIS_URL=redis://localhost:6379/1
# Browser suite: the production server runs as the loopback-only offense_demo_e2e
# login (a member of offense_demo_web) against this slot's own e2e database, in its
# own Redis database and namespace. E2E_PORT and the next two ports are the app, TLS edge and mail
# capture; a pinned port also disables reuse of a running server.
E2E_PORT=3100
E2E_DATABASE_URL=postgres://offense_demo_e2e:e2e-loopback-only@localhost:15432/offense_demo_e2e
E2E_REDIS_URL=redis://localhost:6379/2
E2E_REDIS_NAMESPACE=offense-demo-e2e
# PageSpace incoming webhooks for the project drive (ids and page layout live
# in project.config.json; webhook URLs and secrets stay here).
# Channel notifications are signed POSTs; CI reads these from Actions secrets.
PAGESPACE_STANDUP_WEBHOOK_URL=
PAGESPACE_STANDUP_WEBHOOK_SECRET=
PAGESPACE_INCIDENTS_WEBHOOK_URL=
PAGESPACE_INCIDENTS_WEBHOOK_SECRET=
PAGESPACE_SPRINT_ROOM_WEBHOOK_URL=
PAGESPACE_SPRINT_ROOM_WEBHOOK_SECRET=
PAGESPACE_EPIC_UPDATES_WEBHOOK_URL=
PAGESPACE_EPIC_UPDATES_WEBHOOK_SECRET=
# The documentation drive, folder and agent come from project.config.json;
# set these only to point the pipeline at another (staging) drive.
# PAGESPACE_DOCUMENTATION_DRIVE_ID=
# PAGESPACE_DOCUMENTATION_ROOT_PAGE_ID=
# PAGESPACE_DOCUMENTATION_AGENT_PAGE_ID=
# Drive-scoped agent key, minted by `bun drive:bootstrap` with the drive's
# "Agent" role (view and edit): the board, decision and docs scripts write
# with it. Keep the value in .env or an Actions secret, never in Git.
PAGESPACE_TOKEN=
# --- Authentication (email magic links and passkeys) -------------------------
# BETTER_AUTH_SECRET: 64-character random value. Run `bun auth:provision` to
# generate one into .env when missing; existing values are preserved. Never
# commit a real value.
# BETTER_AUTH_SECRET=<64-character random value>
# RECIPIENT_HASH_SECRET: 64-character random value, independent of
# BETTER_AUTH_SECRET (ADR 0044, ISSUE-141) so rotating the session-signing
# secret can never desynchronize the suppression ledger or per-recipient
# rate-limit buckets from hashes already stored under them. Run
# `bun auth:provision` to generate one into .env when missing; existing
# values are preserved. Never commit a real value.
# RECIPIENT_HASH_SECRET=<64-character random value>
# RESEND_API_KEY and AUTH_EMAIL_FROM need owner-provisioned Resend access and a
# verified sender domain (human prerequisite; see the authentication spec).
# They are optional for local development: with both left unset (commented
# out, not blank), NODE_ENV=development and a localhost PUBLIC_APP_URL,
# `bun dev` prints each auth email and its sign-in link to the terminal as
# [dev-mail] lines instead of sending it (ADR 0050). Every other environment
# (test, staging, production) refuses to start auth without both.
# RESEND_API_KEY=<re_… key from the Resend dashboard>
# AUTH_EMAIL_FROM=Offense Demo <no-reply@example.com>
# RESEND_WEBHOOK_SECRET: Svix signing secret (whsec_…) of the Resend webhook that
# targets /api/webhooks/resend. Required in production; never commit a real value.
# RESEND_WEBHOOK_SECRET=<whsec_… secret from the Resend webhook>
# Client identity has exactly one resolver: the ingress (start.ts) stamps
# x-offense-demo-client-ip on every request from the socket peer, replacing any
# caller-supplied value, and Better Auth trusts only that one header — never
# a second, deployment-configured header of its own. Behind a reverse proxy
# set AUTH_TRUSTED_PROXIES: the X-Forwarded-For chain is then walked right to
# left past those hops. If your proxy is not listed, every user shares the
# proxy's address and one rate-limit bucket. `next dev` runs without the
# ingress, so no request carries x-offense-demo-client-ip in local development;
# every dev-mode request then shares one "unknown" rate-limit bucket, which
# is accepted, not a bug.
# AUTH_TRUSTED_PROXIES: comma-separated IPs or CIDR ranges of your own proxies,
# or the keyword `gateway`, which trusts only this machine's default gateway
# read from /proc/net/route at start (Linux; fly.toml uses it, DEC-39).
# Entries are validated more strictly than Better Auth does, and anything else
# fails configuration:
# plain IPv4/IPv6 addresses or CIDR ranges only, no leading-zero prefix (/08),
# and no IPv4-mapped IPv6 (::ffff:10.0.0.0/104). Write the IPv4 form instead.
# AUTH_TRUSTED_PROXIES=10.0.0.0/8
# OPS_PROBE_TOKEN: bearer credential for the read-only /api/ops/alerts and
# /api/ops/metrics endpoints (AUTH-7.7). Required in production; only the
# scheduled auth-alerts.yml workflow holds it. At least 32 characters; never
# commit a real value.
# OPS_PROBE_TOKEN=<32+ character random value>
