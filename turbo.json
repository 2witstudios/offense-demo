{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "packages/typescript-config/*.json",
    "eslint.config.mjs",
    ".prettierrc.json"
  ],
  "globalEnv": ["NODE_ENV", "APP_VERSION", "GIT_COMMIT"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "REDIS_URL",
    "TEST_REDIS_URL",
    "REDIS_NAMESPACE",
    "PUBLIC_APP_URL",
    "LOG_LEVEL",
    "FOUNDATION_PROOF_ENABLED",
    "NEXT_MANUAL_SIG_HANDLE",
    "PORT",
    "REALTIME_PORT",
    "E2E_PORT",
    "E2E_DATABASE_URL",
    "E2E_REDIS_URL",
    "E2E_REDIS_NAMESPACE",
    "PW_WS_ENDPOINT"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "BETTER_AUTH_SECRET",
        "RECIPIENT_HASH_SECRET",
        "RESEND_API_KEY",
        "AUTH_EMAIL_FROM",
        "RESEND_WEBHOOK_SECRET",
        "AUTH_TRUSTED_PROXIES",
        "OPS_PROBE_TOKEN"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "typecheck": { "dependsOn": ["^typecheck"], "outputs": [] },
    "lint": { "outputs": [] },
    "format:check": { "outputs": [] },
    "test": { "dependsOn": ["^typecheck"], "outputs": [] },
    "test:integration": { "cache": false },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": [
        "OFFENSE_DEMO_E2E_CONCURRENCY",
        "OFFENSE_DEMO_E2E_LOCK_DIR",
        "OFFENSE_DEMO_E2E_POLL_MS"
      ]
    },
    "check": { "dependsOn": ["typecheck", "lint", "test", "build"] }
  }
}
